{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": false,
        "target": "ES2024",
        "types": ["node"]
    },
    "include": ["bin/**/*.js", "scripts/**/*.mjs"]
}
