{
    "name": "@mikinho/autover",
    "version": "3.1.1+356618",
    "description": "Strict SemVer build-metadata versioner for Node.js — zero dependencies, deterministic timestamps, workspace-aware, and Git-safe",
    "bin": {
        "autover": "bin/autover.js"
    },
    "type": "module",
    "license": "MIT",
    "author": "Michael Welter <me@mikinho.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mikinho/node-autover.git"
    },
    "bugs": {
        "url": "https://github.com/mikinho/node-autover/issues"
    },
    "homepage": "https://github.com/mikinho/node-autover#readme",
    "keywords": [
        "semver",
        "versioning",
        "semantic-versioning",
        "git-hooks",
        "post-commit",
        "build-metadata",
        "prerelease",
        "workspaces",
        "monorepo",
        "npm",
        "nodejs",
        "cli",
        "ci-cd",
        "package-version",
        "developer-tools",
        "zero-dependency"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@eslint/markdown": "^8.0.3",
        "@types/node": "^20.19.43",
        "@types/punycode": "^2.1.4",
        "auto-changelog": "^2.6.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.12.0",
        "jsdoc": "^4.0.5",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "changelog": "auto-changelog -p --commit-limit false",
        "docs": "node scripts/gen-docs.mjs",
        "docs:clean": "rimraf docs || rmdir /s /q docs 2> NUL || true",
        "docs:open": "node -e \"import('node:child_process').then(m=>m.exec(process.platform==='win32'?'start docs/index.html':(process.platform==='darwin'?'open docs/index.html':'xdg-open docs/index.html')))\"",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "release:check": "node scripts/verify-release.mjs",
        "release:major": "node scripts/prepare-release.mjs major",
        "release:minor": "node scripts/prepare-release.mjs minor",
        "release:patch": "node scripts/prepare-release.mjs patch",
        "test": "node --test",
        "test:package": "node scripts/check-package.mjs",
        "test:release": "node --test tests/release.test.js",
        "test:unit": "npm test",
        "typecheck": "tsc -p jsconfig.json",
        "ver:apply": "node ./bin/autover.js --guard-unchanged --short",
        "ver:preview": "node ./bin/autover.js --no-amend --dry-run --short",
        "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run docs && npm run test:package"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "bin",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "packageManager": "npm@11.17.0"
}
